# Logical Partitions (Flashable Images)
/system          ext4              /dev/block/bootdevice/by-name/system     flags=display="System";backup=1;flashimg=1
/vendor          ext4              /dev/block/bootdevice/by-name/vendor     flags=display="Vendor";wipeingui;backup=1;flashimg=1
/oem             ext4              /dev/block/bootdevice/by-name/oem        flags=display="OEM";backup=1;flashimg=1

# Boot & Recovery
/boot            emmc              /dev/block/bootdevice/by-name/boot       flags=display="Boot";backup=1;flashimg=1
/recovery        emmc              /dev/block/bootdevice/by-name/recovery   flags=display="Recovery";backup=1;flashimg=1

# Data & Cache
/data            f2fs              /dev/block/bootdevice/by-name/userdata   flags=encryptable=/dev/block/bootdevice/by-name/metadata
/cache           ext4              /dev/block/bootdevice/by-name/cache
/persist         ext4              /dev/block/bootdevice/by-name/persist    flags=display="Persist";backup=1

# Modem & EFS (¡CRÍTICO para señal/IMEI!)
/firmware        vfat              /dev/block/bootdevice/by-name/modem      flags=display="Firmware";mounttodecrypt;fsflags=ro
/modemst1        emmc              /dev/block/bootdevice/by-name/modemst1   flags=display="EFS (modemst1)";backup=1
/modemst2        emmc              /dev/block/bootdevice/by-name/modemst2   flags=display="EFS (modemst2)";backup=1;subpartitionof=/modemst1
/fsg             emmc              /dev/block/bootdevice/by-name/fsg        flags=display="FSG";backup=1;subpartitionof=/modemst1

# Otros de Motorola
/logo            emmc              /dev/block/bootdevice/by-name/logo       flags=display="Logo";backup=1;flashimg=1
/misc            emmc              /dev/block/bootdevice/by-name/misc
/fsc             emmc              /dev/block/bootdevice/by-name/fsc        flags=display="FSC";backup=1;subpartitionof=/modemst1

# Almacenamiento Externo
/external_sd     vfat              /dev/block/mmcblk1p1 /dev/block/mmcblk1p1  flags=removable;storage;wipeingui;display="Micro SDCard"
/usb-otg         vfat              /dev/block/sda1      /dev/block/sda      flags=removable;storage;wipeingui;display="USB OTG"
